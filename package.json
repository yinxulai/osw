{
  "name": "osw",
  "private": true,
  "version": "1.3.0-beta.3",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "yinxulai <yinxulai@hotmail.com>",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:preview": "pnpm --filter @osw/console run dev",
    "build": "turbo run build",
    "build:cli": "pnpm --filter @osw/console run build && pnpm --filter @osw/cli run build",
    "build:www": "pnpm --filter @osw/www run build",
    "deploy:www": "pnpm --filter @osw/www run deploy",
    "build:docs": "pnpm --filter @osw/docs run build",
    "deploy:docs": "pnpm --filter @osw/docs run deploy",
    "start:cli": "node apps/cli/output/index.js",
    "smoke:cli": "pnpm --filter @osw/cli run smoke",
    "release:mac": "pnpm build && pnpm --filter @osw/app run package:mac",
    "release:win": "pnpm build && pnpm --filter @osw/app run package:win",
    "release:linux": "pnpm build && pnpm --filter @osw/app run package:linux",
    "release:notes": "node apps/app/scripts/release-notes.mjs",
    "icons": "node apps/app/scripts/generate-icons.mjs",
    "screenshots": "node apps/app/scripts/screenshots.mjs",
    "lint": "node packages/toolkit/scripts/lint.mjs",
    "lint:layers": "node packages/core/scripts/check-proxy-layers.mjs",
    "db": "node packages/core/scripts/db.mjs",
    "db:generate": "node packages/core/scripts/db.mjs generate",
    "test": "node packages/toolkit/scripts/test.mjs",
    "test:server": "node packages/toolkit/scripts/test.mjs",
    "test:coverage": "node packages/toolkit/scripts/test.mjs --coverage",
    "typecheck": "node packages/toolkit/scripts/typecheck.mjs",
    "version:set": "node packages/toolkit/scripts/version.mjs",
    "version:check": "node packages/toolkit/scripts/version.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/history": "^1.162.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "device-detector-js": "^3.0.3",
    "dompurify": "^3.4.17",
    "drizzle-orm": "1.0.0-rc.4",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.56.0",
    "marked": "^18.1.1",
    "next-themes": "^0.4.6",
    "proxy-agent": "^8.0.2",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.14.5",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript-eslint/utils": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "@yinxulai/eslint-plugin-peculiar": "^1.0.6",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "^44.7.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
