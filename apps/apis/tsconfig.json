{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    // 别名在这里重写一遍，而不是继承根 `tsconfig.json` 的那份。
    //
    // wrangler 用 esbuild 打包，它按「离入口最近的那份 tsconfig」解析 `paths`；
    // 这里写成相对路径以兼容现代 TypeScript，避免 `baseUrl` 这类已移除配置。
    //
    // 只留 Worker 真用得上的一个别名：它依赖 `packages/contracts/source`，其余都不行
    // （包边界由 `packages/toolkit/scripts/check-package-boundaries.mjs` 保证）。
    "paths": {
      "@common/*": ["../../packages/contracts/source/*"]
    }
  },
  "include": ["source/**/*.ts"],
  "references": []
}
